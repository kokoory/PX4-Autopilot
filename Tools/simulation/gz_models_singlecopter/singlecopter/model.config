<?xml version="1.0" encoding="UTF-8"?>
<model>
  <name>Singlecopter</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Singlecopter with 1 motor and 4 control vanes.
    Single propeller provides thrust, four servo-actuated vanes
    below the propeller deflect prop wash for attitude control.
    Designed for knowledge distillation experiments.
  </description>
</model>
