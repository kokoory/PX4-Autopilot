<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='singlecopter'>
    <pose>0 0 0.18 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <!--
      Ball Drone MK II Layout (top to bottom):
        z=+0.10  FC / Battery (heaviest, CoG here)
        z=+0.04  Motor mount
        z=+0.02  Propeller plane
        z=-0.05  Control vanes (4x servo)
        z=-0.12  Landing legs

      This top-heavy layout creates pendulum stability:
      CoG above thrust vectoring point = self-stabilizing tendency
    -->

    <!-- Main body -->
    <link name="base_link">
      <inertial>
        <!-- CoG at upper portion (FC/battery mass dominates) -->
        <pose>0 0 0.06 0 0 0</pose>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.006</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.006</iyy>
          <iyz>0</iyz>
          <izz>0.004</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>

      <!-- Upper body: FC + Battery housing (top of vehicle) -->
      <visual name="fc_battery_housing">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.065</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>

      <!-- Middle body: Motor mount structure -->
      <visual name="motor_frame">
        <pose>0 0 0.04 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Motor body (between FC and propeller) -->
      <visual name="motor_body">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Lower body: Vane support structure -->
      <visual name="vane_frame">
        <pose>0 0 -0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.035</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>

      <!-- Cross struts connecting body to vane mounts -->
      <visual name="strut_front">
        <pose>0.035 0 -0.04 0 1.5708 0</pose>
        <geometry>
          <cylinder><radius>0.004</radius><length>0.04</length></cylinder>
        </geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="strut_right">
        <pose>0 0.035 -0.04 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.004</radius><length>0.04</length></cylinder>
        </geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="strut_back">
        <pose>-0.035 0 -0.04 0 1.5708 0</pose>
        <geometry>
          <cylinder><radius>0.004</radius><length>0.04</length></cylinder>
        </geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="strut_left">
        <pose>0 -0.035 -0.04 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.004</radius><length>0.04</length></cylinder>
        </geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>

      <collision name="body_collision">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.065</radius>
            <length>0.20</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Landing legs (4x, at bottom) -->
      <visual name="leg_0">
        <pose>0.05 0.05 -0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="leg_1">
        <pose>-0.05 0.05 -0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="leg_2">
        <pose>0.05 -0.05 -0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="leg_3">
        <pose>-0.05 -0.05 -0.12 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.06</length></cylinder></geometry>
        <material><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>

      <!-- Front marker (red dot to identify orientation) -->
      <visual name="front_marker">
        <pose>0.066 0 0.08 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.001</length></cylinder></geometry>
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>

      <!-- IMU sensor (located at FC position, top of vehicle) -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.08 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.1</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- Air pressure sensor -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></pressure>
        </air_pressure>
      </sensor>
    </link>

    <!-- Propeller (below motor, above vanes) at z=0.02 -->
    <link name="rotor_0">
      <pose relative_to="base_link">0 0 0.02 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.75e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000166704</iyy>
          <iyz>0</iyz>
          <izz>9.75e-05</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <visual name="rotor_0_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_base/meshes/1345_prop_ccw.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <child>rotor_0</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- === Control Vanes (below propeller, z=-0.05) ===
         Ball Drone layout (top view):

              V0 (Front, +X)
                |
         V3 ---+--- V1
         (-Y)  |   (+Y)
              V2 (Back, -X)

         Each vane is a flat plate that pivots to deflect prop wash.
    -->

    <!-- Vane 0: Front (+X) - pivots around Y axis -->
    <link name="vane_0">
      <pose relative_to="base_link">0.05 0 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1.5e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.5e-06</iyy><iyz>0</iyz><izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="vane_0_visual">
        <geometry><box><size>0.002 0.06 0.05</size></box></geometry>
        <material><ambient>0.9 0.2 0.2 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material>
      </visual>
    </link>
    <joint name="vane_0_joint" type="revolute">
      <child>vane_0</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.5</lower><upper>0.5</upper></limit>
      </axis>
    </joint>

    <!-- Vane 1: Right (+Y) - pivots around X axis -->
    <link name="vane_1">
      <pose relative_to="base_link">0 0.05 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1.5e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.5e-06</iyy><iyz>0</iyz><izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="vane_1_visual">
        <geometry><box><size>0.06 0.002 0.05</size></box></geometry>
        <material><ambient>0.2 0.9 0.2 1</ambient><diffuse>0.3 0.9 0.3 1</diffuse></material>
      </visual>
    </link>
    <joint name="vane_1_joint" type="revolute">
      <child>vane_1</child>
      <parent>base_link</parent>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.5</lower><upper>0.5</upper></limit>
      </axis>
    </joint>

    <!-- Vane 2: Back (-X) - pivots around Y axis -->
    <link name="vane_2">
      <pose relative_to="base_link">-0.05 0 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1.5e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.5e-06</iyy><iyz>0</iyz><izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="vane_2_visual">
        <geometry><box><size>0.002 0.06 0.05</size></box></geometry>
        <material><ambient>0.2 0.2 0.9 1</ambient><diffuse>0.3 0.3 0.9 1</diffuse></material>
      </visual>
    </link>
    <joint name="vane_2_joint" type="revolute">
      <child>vane_2</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.5</lower><upper>0.5</upper></limit>
      </axis>
    </joint>

    <!-- Vane 3: Left (-Y) - pivots around X axis -->
    <link name="vane_3">
      <pose relative_to="base_link">0 -0.05 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1.5e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.5e-06</iyy><iyz>0</iyz><izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="vane_3_visual">
        <geometry><box><size>0.06 0.002 0.05</size></box></geometry>
        <material><ambient>0.9 0.9 0.2 1</ambient><diffuse>0.9 0.9 0.3 1</diffuse></material>
      </visual>
    </link>
    <joint name="vane_3_joint" type="revolute">
      <child>vane_3</child>
      <parent>base_link</parent>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-0.5</lower><upper>0.5</upper></limit>
      </axis>
    </joint>

    <!-- Motor plugin (single motor, thrust downward) -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1200.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Joint position controllers for servo vanes -->
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>vane_0_joint</joint_name>
      <topic>/model/singlecopter/command/servo_0</topic>
      <p_gain>20</p_gain><i_gain>0.5</i_gain><d_gain>0.1</d_gain>
      <cmd_max>0.5</cmd_max><cmd_min>-0.5</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>vane_1_joint</joint_name>
      <topic>/model/singlecopter/command/servo_1</topic>
      <p_gain>20</p_gain><i_gain>0.5</i_gain><d_gain>0.1</d_gain>
      <cmd_max>0.5</cmd_max><cmd_min>-0.5</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>vane_2_joint</joint_name>
      <topic>/model/singlecopter/command/servo_2</topic>
      <p_gain>20</p_gain><i_gain>0.5</i_gain><d_gain>0.1</d_gain>
      <cmd_max>0.5</cmd_max><cmd_min>-0.5</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>vane_3_joint</joint_name>
      <topic>/model/singlecopter/command/servo_3</topic>
      <p_gain>20</p_gain><i_gain>0.5</i_gain><d_gain>0.1</d_gain>
      <cmd_max>0.5</cmd_max><cmd_min>-0.5</cmd_min>
    </plugin>

    <!-- Lift/drag plugins for vanes (prop wash interaction) -->
    <plugin filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0><cla>4.0</cla><cda>0.1</cda><cma>0.0</cma>
      <alpha_stall>0.5</alpha_stall><cla_stall>-0.2</cla_stall>
      <cda_stall>1.0</cda_stall><cma_stall>0.0</cma_stall>
      <cp>0.05 0 -0.05</cp><area>0.003</area><air_density>1.2041</air_density>
      <forward>1 0 0</forward><upward>0 0 1</upward>
      <link_name>vane_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0><cla>4.0</cla><cda>0.1</cda><cma>0.0</cma>
      <alpha_stall>0.5</alpha_stall><cla_stall>-0.2</cla_stall>
      <cda_stall>1.0</cda_stall><cma_stall>0.0</cma_stall>
      <cp>0 0.05 -0.05</cp><area>0.003</area><air_density>1.2041</air_density>
      <forward>0 1 0</forward><upward>0 0 1</upward>
      <link_name>vane_1</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0><cla>4.0</cla><cda>0.1</cda><cma>0.0</cma>
      <alpha_stall>0.5</alpha_stall><cla_stall>-0.2</cla_stall>
      <cda_stall>1.0</cda_stall><cma_stall>0.0</cma_stall>
      <cp>-0.05 0 -0.05</cp><area>0.003</area><air_density>1.2041</air_density>
      <forward>-1 0 0</forward><upward>0 0 1</upward>
      <link_name>vane_2</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system"
      name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0><cla>4.0</cla><cda>0.1</cda><cma>0.0</cma>
      <alpha_stall>0.5</alpha_stall><cla_stall>-0.2</cla_stall>
      <cda_stall>1.0</cda_stall><cma_stall>0.0</cma_stall>
      <cp>0 -0.05 -0.05</cp><area>0.003</area><air_density>1.2041</air_density>
      <forward>0 -1 0</forward><upward>0 0 1</upward>
      <link_name>vane_3</link_name>
    </plugin>

  </model>
</sdf>
